{
    "name": "iplicit/api-client",
    "description": "PHP API client for Iplicit online financial accounting software",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "trevstoke",
            "email": "trevor@trevweb.co.uk"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Iplicit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Iplicit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
